+@torch.no_grad()
+def _newton_schulz_maybe_gpu(
+    grad: Tensor,
+    ns_coefficients: Tuple[float, float, float],
+    ns_steps: int,
+    eps: float,
+) -> Tensor:
+    """★ B 方案补丁4(2026-09-04):offload 模式下优化器张量在 CPU,NS 是纯矩阵乘,
+    5.7B 参数在 24 核 CPU 上要 10-20 分钟/步(GPU 不到 2 秒)。这里把张量搬上
+    GPU 算完再搬回:同算法同精度(bf16 compute_dtype),仅浮点最低位舍入随
+    CPU/GPU 实现略有差异,对优化器语义无影响。张量本来就在 GPU(多卡/无
+    offload)时直通,行为不变。原件备份:mjq_lingbotvla_v2/B_patch/muon.py.orig
+    """
+    if grad.device.type == "cpu" and torch.cuda.is_available():
+        out = batched_newton_schulz(grad.cuda(), ns_coefficients, ns_steps, eps)
+        return out.cpu()
+    return batched_newton_schulz(grad, ns_coefficients, ns_steps, eps)
+
